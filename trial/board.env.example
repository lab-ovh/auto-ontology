# Copy to trial/board.env (0600). Replace blank operator-owned secrets locally.
POSTGRES_HOST=postgres
POSTGRES_PORT=55432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=auto_ontology
APP_PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
PYTHON_API_URL=http://auto-ontology:3001
MCP_PUBLIC_BASE_URL=http://localhost:3000
AUTO_ONTOLOGY_ADMIN_EMAIL=
AUTO_ONTOLOGY_ADMIN_PASSWORD=
AUTH_SECRET=
# Bare id; confirm availability and non-thinking behavior with Step 0 first.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_KEY_FILE=/home/ubuntu/deepseek/.env
TRIAL_ENV_FILE=trial/board.env
# Set ONLY the new sandbox database's board_reader URL; URL-encode its password.
CONNECTION_STRINGS=
# No reranker is deployed. Compile does not call retrieval reranking.
RERANK_ENDPOINT=http://127.0.0.1:9
RERANK_MODEL=disabled-for-board-trial
RERANK_API_KEY=unused
